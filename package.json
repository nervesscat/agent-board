{
  "name": "agent-board",
  "private": true,
  "description": "CrossBoard: a local job board shared by one developer and their AI coding agents (Claude Code, Codex, opencode), with tickets, PR queue, reviews, previews and daily reports.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "mcp",
    "kanban",
    "job-board",
    "code-review",
    "pull-requests",
    "developer-tools",
    "tanstack-start",
    "sqlite"
  ],
  "license": "MIT",
  "author": "Enrique Madrid",
  "homepage": "https://github.com/nervesscat/agent-board#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nervesscat/agent-board.git"
  },
  "bugs": {
    "url": "https://github.com/nervesscat/agent-board/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/start.mjs --stop",
    "tailnet": "node scripts/tailnet.mjs",
    "move-uploads": "node scripts/move-uploads-to-s3.mjs",
    "desktop:package": "node desktop/package.mjs",
    "desktop:smoke": "node desktop/smoke.mjs",
    "release": "node scripts/release.mjs",
    "art:release": "node scripts/release-art/generate.mjs --all",
    "art:release:check": "node scripts/release-art/generate.mjs --all --check",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit && tsc -p desktop",
    "lint": "oxlint src desktop",
    "format": "prettier --write src scripts desktop e2e playwright.config.ts *.md",
    "format:check": "prettier --check src scripts desktop e2e playwright.config.ts *.md",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:migrations": "node scripts/check-migrations.mjs",
    "bench": "node scripts/bench/bench.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@simplewebauthn/server": "^14.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/router-cli": "^1.167.45",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.1",
    "builder-util-runtime": "9.7.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "electron": "42.11.18",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.11",
    "oxlint": "^1.81.0",
    "prettier": "3.6.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.0.0",
    "ws": "^8.22.2"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 110
  }
}
