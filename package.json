{
  "name": "agent-board",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 47100",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "prettier --write src scripts *.md",
    "format:check": "prettier --check src scripts *.md",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.56",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/router-cli": "^1.132.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "oxlint": "^1.81.0",
    "prettier": "3.6.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 110
  }
}
