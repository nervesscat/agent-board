# Where the board listens. Deliberately unusual so it never collides with a project you are running.
PORT=47100
# The board's own origin, used for the login redirect back from the gate.
BOARD_URL=http://localhost:47100
# The local passkey-gate (docker-compose.gate.yml). Every request is checked against GATE_URL/auth.
GATE_URL=http://localhost:47110
# SQLite file, uploads and logs live here.
DATA_DIR=./data
# The Claude Code binary that writes the generated daily summaries.
CLAUDE_BIN=claude
# Where attachment files live: local (data/uploads, the default) or s3 (MinIO or any S3-compatible store;
# README: "Storing files in MinIO"). With s3, the S3_* settings say where.
STORAGE=local
# S3_ENDPOINT=http://127.0.0.1:47120
# S3_BUCKET=agent-board
# S3_ACCESS_KEY=agent-board
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# Bind address of the built server (pnpm start). Keep it loopback: the gate cookie is only meaningful on localhost.
HOST=127.0.0.1
