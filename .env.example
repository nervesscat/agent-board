# Where the board listens. Deliberately unusual so it never collides with a project you are running.
PORT=47100
# The board's own origin on this machine, as agents and the board's links name it.
BOARD_URL=http://localhost:47100
# SQLite file, uploads and logs live here.
DATA_DIR=./data
# The Claude Code binary that writes the generated reports (the prompt goes to its stdin).
CLAUDE_BIN=claude
# The user-wide .claude folder the Agents pages check the review skills against (Global), on the machine
# the board runs on. Default: ~/.claude. Another folder gets its own install line there.
# CLAUDE_HOME=~/.claude
# Arguments put before claude's own, as a JSON array of strings (the tests run a stand-in through node).
# CLAUDE_ARGS=[]
# How long one run of claude may take before it is stopped, in milliseconds (default 120000).
# CLAUDE_TIMEOUT_MS=120000
# Where attachment files live: local (data/uploads, the default) or s3 (MinIO or any S3-compatible store;
# README: "Storing files in MinIO"). With s3, the S3_* settings say where.
STORAGE=local
# S3_ENDPOINT=http://127.0.0.1:47120
# S3_BUCKET=agent-board
# S3_ACCESS_KEY=agent-board
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# Bind address of the board (pnpm start). Keep it loopback: other devices come in through the tailnet (below).
HOST=127.0.0.1
# What this board is (README: "Test mode"). production (the default, also when unset) always requires sign-in;
# leave it unset on the live board. pnpm start and pnpm redeploy force production.
# BOARD_ENV=production
# development (pnpm dev sets it) requires it unless AUTH=off; test (CI, Playwright) never does, and
# takes the caller from the X-Test-Actor header (human:<name> or agent:<name>).
# AUTH=off is refused in production, off loopback (HOST) and on port 47100.
# AUTH=on
# Who you are with AUTH=off in development (default: the human the board last saw sign in, else human).
# DEV_HUMAN=
# Who a test-mode request without X-Test-Actor is.
# TEST_HUMAN=human
# The board on your other devices, through your tailnet (README: "Using it from other devices"): unset
# is off. Ignored with sign-in off. Run `pnpm tailnet` for the value here. The board as those devices
# open it: https, this machine's tailnet name, no port and no path. Their passkeys are for that name.
# PUBLIC_ORIGIN=https://<machine>.<tailnet>.ts.net
# GATE_URL, PUBLIC_GATE_URL and PUBLIC_GATE_AUTH_URL from an earlier setup are no longer read: delete them.
