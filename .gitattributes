# Skills and agents installed from the board, kept exactly as written (LF) on every checkout.
src/server/skill/review/** text eol=lf
# Static files served as they are (the favicon is byte for byte the supplied logo file).
public/** -text
# Shell scripts run in Linux as they are checked out (the desktop app's container tests).
*.sh text eol=lf
# Release artwork is generated and compared byte for byte by its test; a line-ending conversion on
# checkout would make the committed files disagree with a fresh run.
src/assets/release-art/**/*.svg -text
src/assets/release-art/**/manifest.json -text
